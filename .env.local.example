# ============================================================
# 竹子嵌入式设备监控平台 - 环境变量示例
# 复制本文件为 .env.local 并填入真实值后即可连接 Supabase
#   cp .env.local.example .env.local
# ============================================================

# Supabase 连接配置（Supabase 项目 -> Project Settings -> API）
# 注意：URL 只填到域名，不要带 /rest/v1/ 等路径
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 高德地图 Web 端 JS API Key（可选，不填则使用内置坐标分布示意视图）
VITE_AMAP_KEY=
